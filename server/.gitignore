# Byte-compiled files
__pycache__/
*.py[cod]

# The virtualenv uv builds. Platform-specific: the Docker image builds its own,
# and .dockerignore keeps this one out of the image.
.venv

# Secrets. `cp .env.example .env` is step 1 of the README, and the result must
# never be committed.
.env

# Tool caches
.pytest_cache/
.ruff_cache/

# Build artefacts. hatchling is the declared build backend, so `uv build` can
# produce these even though no documented workflow runs it.
build/
dist/
*.egg-info/

# The runtime SQLite database (DATABASE_URL=sqlite:///./data/app.db)
data/
